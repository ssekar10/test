# AGENT ENVIRONMENT CONFIG - PRODUCTION


# BASIC AGENT INFORMATION
AGENT_NAME=gcp-ops-intelligent-assistant
AGENT_DIRECTORY=master_agent
ENVIRONMENT=prod
DEPLOY_REGIONS=us-east4
ALL_REGIONS=us-east4


# GOOGLE CLOUD PROJECT INFO
GCP_PROJECT_ID=dxp-cloud-ivr-prod-XXXXXX  # UPDATE with prod project ID
STAGING_BUCKET=gs://adk-template-prod-ivr  # UPDATE with prod bucket
GOOGLE_CLOUD_PROJECT=dxp-cloud-ivr-prod-XXXXXX  # UPDATE with prod project ID
GOOGLE_CLOUD_LOCATION=us-east4
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_LOCATION=global
LOCATION=us-east4
location=us-east4


# AUTHENTICATION (CI/CD)
# Workload Identity Federation (used by GitHub Actions)
GCP_SA_WIF_PROVIDER=projects/XXXXXX/locations/global/workloadIdentityPools/github/providers/github  # UPDATE with prod values
GCP_SA_WIF_SA=svc-ivr-prod-github-actions@dxp-cloud-ivr-prod-XXXXXX.iam.gserviceaccount.com  # UPDATE

# Agent Runtime Service Account
AGENT_RUNTIME_SA=svc-ivr-prod-github-actions@dxp-cloud-ivr-prod-XXXXXX.iam.gserviceaccount.com  # UPDATE


# APIGEE CONFIGURATION
APG_PROJECT_ID=dxp-cloud-ivr-prod-XXXXXX  # UPDATE
APG_ENVIRONMENT=prod
APG_KVM_NAME=kvm-agents
APG_AGENT_NAME=gcp_ops_intelligent_assistant


# TOOLS CONFIGURATION
DUMMY_URL=https://api.example.com/dummy # Update respective tool URLS


# APIGEE API KEYS
# APIGEE_API_KEY=<your environment apigee api key>
# APIGEE_URL=<your-auth-proxy-url>


# GENERATIVE AI / MODEL CONFIG
GEMINI_MODEL=gemini-2.5-pro


# TELEMETRY / LOGGING
OTEL_SERVICE_NAME=gcp_ops_intelligent_assistant
ENABLE_CUSTOM_OTEL_TRACE=TRUE
ENABLE_GCP_LOGGING=true  # Enable in production
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false  # Disable content capture in prod for security
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Logging
LOG_LEVEL=WARNING  # More restrictive in production

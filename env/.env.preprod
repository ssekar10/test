# AGENT ENVIRONMENT CONFIG - PRE-PRODUCTION


# BASIC AGENT INFORMATION
AGENT_NAME=gcp-ops-intelligent-assistant
AGENT_DIRECTORY=master_agent
ENVIRONMENT=preprod
DEPLOY_REGIONS=us-east4
ALL_REGIONS=us-east4


# GOOGLE CLOUD PROJECT INFO
GCP_PROJECT_ID=dxp-cloud-ivr-preprod-XXXXXX  # UPDATE with preprod project ID
STAGING_BUCKET=gs://adk-template-preprod-ivr  # UPDATE with preprod bucket
GOOGLE_CLOUD_PROJECT=dxp-cloud-ivr-preprod-XXXXXX  # UPDATE with preprod project ID
GOOGLE_CLOUD_LOCATION=us-east4
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_LOCATION=global
LOCATION=us-east4
location=us-east4


# AUTHENTICATION (CI/CD)
# Workload Identity Federation (used by GitHub Actions)
GCP_SA_WIF_PROVIDER=projects/XXXXXX/locations/global/workloadIdentityPools/github/providers/github  # UPDATE with preprod values
GCP_SA_WIF_SA=svc-ivr-preprod-github-actions@dxp-cloud-ivr-preprod-XXXXXX.iam.gserviceaccount.com  # UPDATE

# Agent Runtime Service Account
AGENT_RUNTIME_SA=svc-ivr-preprod-github-actions@dxp-cloud-ivr-preprod-XXXXXX.iam.gserviceaccount.com  # UPDATE


# APIGEE CONFIGURATION
APG_PROJECT_ID=dxp-cloud-ivr-preprod-XXXXXX  # UPDATE
APG_ENVIRONMENT=preprod
APG_KVM_NAME=kvm-agents
APG_AGENT_NAME=gcp_ops_intelligent_assistant


# TOOLS CONFIGURATION
DUMMY_URL=https://api.example.com/dummy # Update respective tool URLS


# APIGEE API KEYS
# APIGEE_API_KEY=<your environment apigee api key>
# APIGEE_URL=<your-auth-proxy-url>


# GENERATIVE AI / MODEL CONFIG
GEMINI_MODEL=gemini-2.5-pro


# TELEMETRY / LOGGING
OTEL_SERVICE_NAME=gcp_ops_intelligent_assistant
ENABLE_CUSTOM_OTEL_TRACE=TRUE
ENABLE_GCP_LOGGING=false
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Logging
LOG_LEVEL=INFO
